local WarningLabel =
	Instance.new("TextLabel")

WarningLabel.Size =
	UDim2.fromOffset(300,45)

WarningLabel.Position =
	UDim2.new(.5,-150,.12,0)

WarningLabel.BackgroundColor3 =
	Color3.fromRGB(180,50,50)

WarningLabel.BackgroundTransparency = .15

WarningLabel.TextColor3 =
	Color3.new(1,1,1)

WarningLabel.Font =
	Enum.Font.GothamBold

WarningLabel.TextSize = 13

WarningLabel.Text =
	"⚠ KHÔNG CÓ NGƯỜI GẦN"

WarningLabel.Visible = false
WarningLabel.ZIndex = 500
WarningLabel.Parent = Gui

Instance.new("UICorner",WarningLabel).CornerRadius =
	UDim.new(0,10)

local function CheckNearbyPlayers()

	if not WARNING then

		WarningLabel.Visible = false
		return

	end

	local char =
		LP.Character

	local root =
		char and
		char:FindFirstChild(
			"HumanoidRootPart"
		)

	if not root then
		return
	end

	local nearestPlayer
	local nearestDistance =
		math.huge

	for _,p in ipairs(
		Players:GetPlayers()
	) do

		if p ~= LP then

			local c =
				p.Character

			local r =
				c and
				c:FindFirstChild(
					"HumanoidRootPart"
				)

			local h =
				c and
				c:FindFirstChildOfClass(
					"Humanoid"
				)

			if r and h and h.Health > 0 then

				local d =
					(
						root.Position -
						r.Position
					).Magnitude

				if d < nearestDistance then

					nearestDistance = d
					nearestPlayer = p

				end

			end

		end

	end

	if nearestPlayer
		and nearestDistance <=
		WARNING_DISTANCE then

		WarningLabel.Text =
			"⚠ "..nearestPlayer.DisplayName..
			" đang ở "..math.floor(
				nearestDistance
			).."m!"

		WarningLabel.Visible = true

	else

		WarningLabel.Visible = false

	end

end

task.spawn(function()

	while Gui.Parent do

		CheckNearbyPlayers()

		task.wait(.5)

	end

end)

