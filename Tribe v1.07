--==================================================
-- POWER SLIDER
--==================================================

local powerSliderDragging = false

local function SetPowerDistance(x)

	local left =
		PowerSlider.AbsolutePosition.X

	local width =
		PowerSlider.AbsoluteSize.X

	if width <= 0 then
		return
	end

	local scale =
		math.clamp(
			(x-left)/width,
			0,1
		)

	POWER_DISTANCE =
		math.floor(10 + scale * 20)

	PowerKnob.Position =
		UDim2.new(scale,-9,0,0)

	PowerDistanceLabel.Text =
		"Distance: "..POWER_DISTANCE

end

PowerSlider.InputBegan:Connect(function(input)

	if input.UserInputType ==
		Enum.UserInputType.MouseButton1
		or input.UserInputType ==
		Enum.UserInputType.Touch then

		powerSliderDragging = true
		SetPowerDistance(input.Position.X)

	end

end)

UIS.InputChanged:Connect(function(input)

	if not powerSliderDragging then
		return
	end

	if input.UserInputType ==
		Enum.UserInputType.MouseMovement
		or input.UserInputType ==
		Enum.UserInputType.Touch then

		SetPowerDistance(input.Position.X)

	end

end)

UIS.InputEnded:Connect(function(input)

	if input.UserInputType ==
		Enum.UserInputType.MouseButton1
		or input.UserInputType ==
		Enum.UserInputType.Touch then

		powerSliderDragging = false

	end

end)

local function SetPower(value)

	POWER = value

	PowerButton.Text =
		POWER
		and "POWER : ON"
		or "POWER : OFF"

	PowerButton.BackgroundColor3 =
		POWER
		and Color3.fromRGB(40,180,40)
		or Color3.fromRGB(50,50,50)

	SmallPower.Visible = POWER

end

PowerButton.MouseButton1Click:Connect(function()

	SetPower(not POWER)

end)

--==================================================
-- POWER USE
--==================================================

local function UsePower()

	if not POWER then
		return
	end

	if POWER_COOLDOWN then
		return
	end

	local char = LP.Character

	local root =
		char and
		char:FindFirstChild(
			"HumanoidRootPart"
		)

	if not root then
		return
	end

	POWER_COOLDOWN = true

	root.CFrame =
		root.CFrame +
		root.CFrame.LookVector *
		POWER_DISTANCE

	task.delay(2,function()

		POWER_COOLDOWN = false

	end)

end

SmallPower.MouseButton1Click:Connect(function()
	UsePower()
end)

--==================================================
-- POWER DRAG
--==================================================

local powerDragging = false
local powerDragStart
local powerStartPosition

SmallPower.InputBegan:Connect(function(input)

	if POWER_LOCK then
		return
	end

	if input.UserInputType ==
		Enum.UserInputType.MouseButton1
		or input.UserInputType ==
		Enum.UserInputType.Touch then

		powerDragging = true

		powerDragStart =
			input.Position

		powerStartPosition =
			SmallPower.Position

	end

end)

UIS.InputChanged:Connect(function(input)

	if not powerDragging then
		return
	end

	if input.UserInputType ~=
		Enum.UserInputType.MouseMovement
		and input.UserInputType ~=
		Enum.UserInputType.Touch then
		return
	end

	local delta =
		input.Position -
		powerDragStart

	SmallPower.Position =
		UDim2.new(
			powerStartPosition.X.Scale,
			powerStartPosition.X.Offset +
				delta.X,

			powerStartPosition.Y.Scale,
			powerStartPosition.Y.Offset +
				delta.Y
		)

end)

PowerLockButton.MouseButton1Click:Connect(function()

	POWER_LOCK =
		not POWER_LOCK

	if POWER_LOCK then

		PowerLockButton.Text =
			"🔒 POWER POSITION: LOCK"

		PowerLockButton.BackgroundColor3 =
			Color3.fromRGB(180,50,50)

	else

		PowerLockButton.Text =
			"🔓 POWER POSITION: UNLOCK"

		PowerLockButton.BackgroundColor3 =
			Color3.fromRGB(50,50,50)

	end

end)

