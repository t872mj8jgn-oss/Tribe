--==================================================
-- MEMORY FUNCTIONS
--==================================================

local function SaveMemory(slot)

	if slot < 1 or slot > 3 then
		return
	end

	Memory[slot] = {

		ESP = ESP,
		AIM = AIM,
		AUTO_FARM = AUTO_FARM,

		FARM_SPEED = FARM_SPEED,
		FARM_TYPE = FARM_TYPE,

		POWER = POWER,
		POWER_DISTANCE = POWER_DISTANCE,

		ANTI_AFK = ANTI_AFK,
		FULL_BRIGHT = FULL_BRIGHT,
		NO_FOG = NO_FOG,
		WARNING = WARNING,

		ANTI_WATER_PUSH =
			ANTI_WATER_PUSH,

		ANTI_SLOW =
			ANTI_SLOW,

		WARNING_DISTANCE =
			WARNING_DISTANCE
	}

end

local function LoadMemory(slot)

	if slot < 1 or slot > 3 then
		return
	end

	local data =
		Memory[slot]

	if not data then
		return
	end

	ESP =
		data.ESP

	AIM =
		data.AIM

	AUTO_FARM =
		data.AUTO_FARM

	FARM_SPEED =
		data.FARM_SPEED

	FARM_TYPE =
		data.FARM_TYPE

	POWER =
		data.POWER

	POWER_DISTANCE =
		data.POWER_DISTANCE

	ANTI_AFK =
		data.ANTI_AFK

	FULL_BRIGHT =
		data.FULL_BRIGHT

	NO_FOG =
		data.NO_FOG

	WARNING =
		data.WARNING

	ANTI_WATER_PUSH =
		data.ANTI_WATER_PUSH

	ANTI_SLOW =
		data.ANTI_SLOW

	WARNING_DISTANCE =
		data.WARNING_DISTANCE

	-- UPDATE GUI

	ESPButton.Text =
		ESP and "ESP : ON"
		or "ESP : OFF"

	ESPButton.BackgroundColor3 =
		ESP
		and Color3.fromRGB(40,180,40)
		or Color3.fromRGB(50,50,50)

	AIMButton.Text =
		AIM and "AIM : ON"
		or "AIM : OFF"

	AIMButton.BackgroundColor3 =
		AIM
		and Color3.fromRGB(40,180,40)
		or Color3.fromRGB(50,50,50)

	FarmButton.Text =
		AUTO_FARM
		and "AUTO FARM : ON"
		or "AUTO FARM : OFF"

	FarmButton.BackgroundColor3 =
		AUTO_FARM
		and Color3.fromRGB(40,180,40)
		or Color3.fromRGB(50,50,50)

	FarmSelect.Text =
		"Farm: "..FARM_TYPE.." ▼"

	SpeedLabel.Text =
		"Speed: "..FARM_SPEED

	PowerDistanceLabel.Text =
		"Distance: "..POWER_DISTANCE

	SetPower(POWER)

	AntiAFKButton.Text =
		ANTI_AFK
		and "ANTI AFK : ON"
		or "ANTI AFK : OFF"

	BrightButton.Text =
		FULL_BRIGHT
		and "FULL BRIGHT : ON"
		or "FULL BRIGHT : OFF"

	FogButton.Text =
		NO_FOG
		and "NO FOG : ON"
		or "NO FOG : OFF"

	WarningButton.Text =
		WARNING
		and "WARNING 200M : ON"
		or "WARNING 200M : OFF"

	AntiWaterButton.Text =
		ANTI_WATER_PUSH
		and "ANTI NƯỚC ĐẨY : ON"
		or "ANTI NƯỚC ĐẨY : OFF"

	AntiSlowButton.Text =
		ANTI_SLOW
		and "ANTI CHẬM : ON"
		or "ANTI CHẬM : OFF"

	if not WARNING then
		WarningLabel.Visible = false
	end

end

