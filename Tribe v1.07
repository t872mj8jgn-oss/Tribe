--==================================================

local SpeedSlider =
	Instance.new("Frame")

SpeedSlider.Size =
	UDim2.new(1,0,0,18)

SpeedSlider.Position =
	UDim2.fromOffset(0,112)

SpeedSlider.BackgroundColor3 =
	Color3.fromRGB(50,50,50)

SpeedSlider.BorderSizePixel = 0
SpeedSlider.Active = true
SpeedSlider.Parent = FarmPage

Instance.new("UICorner",SpeedSlider).CornerRadius =
	UDim.new(0,9)

local SpeedKnob =
	Instance.new("Frame")

SpeedKnob.Size =
	UDim2.fromOffset(18,18)

SpeedKnob.Position =
	UDim2.new(0,-9,0,0)

SpeedKnob.BackgroundColor3 =
	Color3.fromRGB(0,170,255)

SpeedKnob.BorderSizePixel = 0
SpeedKnob.Parent = SpeedSlider

Instance.new("UICorner",SpeedKnob).CornerRadius =
	UDim.new(0,9)

local speedDragging = false

local function SetSpeed(x)

	local left =
		SpeedSlider.AbsolutePosition.X

	local width =
		SpeedSlider.AbsoluteSize.X

	if width <= 0 then
		return
	end

	local scale =
		math.clamp(
			(x-left)/width,
			0,1
		)

	FARM_SPEED =
		math.floor(16 + scale * 4)

	SpeedKnob.Position =
		UDim2.new(
			scale,-9,0,0
		)

	SpeedLabel.Text =
		"Speed: "..FARM_SPEED

end

SpeedSlider.InputBegan:Connect(function(input)

	if input.UserInputType ==
		Enum.UserInputType.MouseButton1
		or input.UserInputType ==
		Enum.UserInputType.Touch then

		speedDragging = true
		SetSpeed(input.Position.X)

	end

end)

UIS.InputChanged:Connect(function(input)

	if not speedDragging then
		return
	end

	if input.UserInputType ==
		Enum.UserInputType.MouseMovement
		or input.UserInputType ==
		Enum.UserInputType.Touch then

		SetSpeed(input.Position.X)

	end

end)

UIS.InputEnded:Connect(function(input)

	if input.UserInputType ==
		Enum.UserInputType.MouseButton1
		or input.UserInputType ==
		Enum.UserInputType.Touch then

		speedDragging = false

	end

end)

