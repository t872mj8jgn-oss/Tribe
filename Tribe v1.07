--==================================================
-- ANTI SYSTEM
--==================================================

RunService.Heartbeat:Connect(function()

	local char =
		LP.Character

	local humanoid =
		char and
		char:FindFirstChildOfClass(
			"Humanoid"
		)

	local root =
		char and
		char:FindFirstChild(
			"HumanoidRootPart"
		)

	if not humanoid or not root then
		return
	end

	-- ANTI CHẬM
	if ANTI_SLOW then

		if humanoid.WalkSpeed ~=
			ANTI_SPEED_VALUE then

			humanoid.WalkSpeed =
				ANTI_SPEED_VALUE

		end

	end

	-- ANTI NƯỚC ĐẨY
	if ANTI_WATER_PUSH then

		if humanoid:GetState() ==
			Enum.HumanoidStateType.Swimming then

			local velocity =
				root.AssemblyLinearVelocity

			root.AssemblyLinearVelocity =
				Vector3.new(
					0,
					velocity.Y,
					0
				)

		end

	end

end)

--==================================================
-- RESOURCE CACHE
--==================================================

local Cache = {
	Wood = {},
	Stone = {},
	Apple = {},
	Food = {}
}

local function GetRoot(obj)

	if obj:IsA("BasePart") then
		return obj
	end

	if obj:IsA("Model") then

		return obj.PrimaryPart
			or obj:FindFirstChildWhichIsA(
				"BasePart",
				true
			)

	end

end

local function GetType(obj)

	local n =
		obj.Name:lower()

	if n:find("wood")
		or n:find("tree")
		or n:find("log") then

		return "Wood"
	end

	if n:find("stone")
		or n:find("rock")
		or n:find("ore") then

		return "Stone"
	end

	if n:find("apple") then
		return "Apple"
	end

	if n:find("food")
		or n:find("meat")
		or n:find("berry")
		or n:find("fish") then

		return "Food"
	end

end

local function ScanResources()

	local new = {
		Wood = {},
		Stone = {},
		Apple = {},
		Food = {}
	}

	for _,obj in ipairs(
		workspace:GetDescendants()
	) do

		if obj:IsA("BasePart")
			or obj:IsA("Model") then

			local t =
				GetType(obj)

			local r =
				t and GetRoot(obj)

			if t and r then

				table.insert(
					new[t],
					{
						Root = r,
						Type = t,
						Name = t
					}
				)

			end

		end

	end

	Cache = new

end

--==================================================
-- PLAYER CACHE
--==================================================

local PlayersCache = {}

local function ScanPlayers()

	local char =
		LP.Character

	local root =
		char and
		char:FindFirstChild(
			"HumanoidRootPart"
		)

	if not root then

		PlayersCache = {}
		return

	end

	local list = {}

	for _,p in ipairs(
		Players:GetPlayers()
	) do

		if p ~= LP then

			local c = p.Character

			local r =
				c and
				c:FindFirstChild(
					"HumanoidRootPart"
				)

			local h =
				c and
				c:FindFirstChildOfClass(
					"Humanoid"
				)

			if r and h and h.Health > 0 then

				table.insert(
					list,
					{
						Player = p,
						Root = r,
						Type = "Player",
						Name = p.DisplayName,
						Distance =
							(root.Position -
							r.Position).Magnitude
					}
				)

			end

		end

	end

	table.sort(
		list,
		function(a,b)
			return a.Distance <
				b.Distance
		end
	)

	PlayersCache = {}

	for i = 1,
		math.min(
			MAX_PLAYER,
			#list
		) do

		PlayersCache[i] =
			list[i]

	end

end

--==================================================
-- FARM
--==================================================

local FarmTypes = {
	"Wood",
	"Stone",
	"Apple",
	"Food",
	"Player"
}

local FarmIndex = 1

local function GetFarmTarget()

	local char =
		LP.Character

	local root =
		char and
		char:FindFirstChild(
			"HumanoidRootPart"
		)

	if not root then
		return nil
	end

	if FARM_TYPE == "Player" then

		local best
		local bestDistance =
			math.huge

		for _,data in ipairs(
			PlayersCache
		) do

			if data.Root
				and data.Root.Parent then

				local d =
					(
						root.Position -
						data.Root.Position
					).Magnitude

				if d < bestDistance then

					bestDistance = d
					best = data

				end

			end

		end

		return best,bestDistance

	end

	local best
	local bestDistance =
		math.huge

	for _,data in ipairs(
		Cache[FARM_TYPE] or {}
	) do

		local r = data.Root

		if r and r.Parent then

			local d =
				(
					root.Position -
					r.Position
				).Magnitude

			if d < bestDistance then

				bestDistance = d
				best = data

			end

		end

	end

	return best,bestDistance

end

FarmSelect.MouseButton1Click:Connect(function()

	FarmIndex += 1

	if FarmIndex > #FarmTypes then
		FarmIndex = 1
	end

	FARM_TYPE =
		FarmTypes[FarmIndex]

	FarmSelect.Text =
		"Farm: "..FARM_TYPE.." ▼"

end)

FarmButton.MouseButton1Click:Connect(function()

	AUTO_FARM =
		not AUTO_FARM

	FarmButton.Text =
		AUTO_FARM
		and "AUTO FARM : ON"
		or "AUTO FARM : OFF"

	FarmButton.BackgroundColor3 =
		AUTO_FARM
		and Color3.fromRGB(40,180,40)
		or Color3.fromRGB(50,50,50)

end)

task.spawn(function()

	while Gui.Parent do

		if AUTO_FARM then

			local char =
				LP.Character

			local humanoid =
				char and
				char:FindFirstChildOfClass(
					"Humanoid"
				)

			local root =
				char and
				char:FindFirstChild(
					"HumanoidRootPart"
				)

			if humanoid and root then

				humanoid.WalkSpeed =
					FARM_SPEED

				local target =
					GetFarmTarget()

				if target
					and target.Root then

					humanoid:MoveTo(
						target.Root.Position
					)

				end

			end

		end

		task.wait(.15)

	end

end)

--==================================================
-- AIM
--==================================================

local function FindNearestPlayer()

	local char =
		LP.Character

	local root =
		char and
		char:FindFirstChild(
			"HumanoidRootPart"
		)

	if not root then
		return nil
	end

	local nearest
	local nearestDistance =
		math.huge

	for _,p in ipairs(
		Players:GetPlayers()
	) do

		if p ~= LP then

			local c =
				p.Character

			local r =
				c and
				c:FindFirstChild(
					"HumanoidRootPart"
				)

			local h =
				c and
				c:FindFirstChildOfClass(
					"Humanoid"
				)

			if r and h and h.Health > 0 then

				local distance =
					(
						root.Position -
						r.Position
					).Magnitude

				if distance <
					nearestDistance then

					nearestDistance =
						distance

					nearest = p

				end

			end

		end

	end

	return nearest

end

AIMButton.MouseButton1Click:Connect(function()

	AIM =
		not AIM

	AIMButton.Text =
		AIM
		and "AIM : ON"
		or "AIM : OFF"

	AIMButton.BackgroundColor3 =
		AIM
		and Color3.fromRGB(40,180,40)
		or Color3.fromRGB(50,50,50)

end)

task.spawn(function()

	while Gui.Parent do

		if AIM then
			AIM_TARGET =
				FindNearestPlayer()
		else
			AIM_TARGET = nil
		end

		task.wait(.1)

	end

end)

RunService.RenderStepped:Connect(function()

	if not AIM or not AIM_TARGET then
		return
	end

	local char =
		LP.Character

	local root =
		char and
		char:FindFirstChild(
			"HumanoidRootPart"
		)

	local targetChar =
		AIM_TARGET.Character

	local targetRoot =
		targetChar and
		targetChar:FindFirstChild(
			"HumanoidRootPart"
		)

	if not root or not targetRoot then
		return
	end

	local targetPosition =
		Vector3.new(
			targetRoot.Position.X,
			root.Position.Y,
			targetRoot.Position.Z
		)

	if (
		targetPosition -
		root.Position
	).Magnitude > .1 then

		root.CFrame =
			CFrame.lookAt(
				root.Position,
				targetPosition
			)

	end

end)

--==================================================
-- ESP
--==================================================

local Pool = {}

local function MakeESP()

	local line =
		Instance.new("Frame")

	line.Size =
		UDim2.fromOffset(0,2)

	line.AnchorPoint =
		Vector2.new(.5,.5)

	line.BackgroundColor3 =
		Color3.new(1,1,1)

	line.BorderSizePixel = 0
	line.Visible = false
	line.ZIndex = 20
	line.Parent = Gui

	local text =
		Instance.new("TextLabel")

	text.Size =
		UDim2.fromOffset(170,35)

	text.AnchorPoint =
		Vector2.new(.5,.5)

	text.BackgroundTransparency = 1

	text.TextColor3 =
		Color3.new(1,1,1)

	text.TextStrokeTransparency = 0

	text.Font =
		Enum.Font.GothamBold

	text.TextSize = 13

	text.Visible = false
	text.ZIndex = 21
	text.Parent = Gui

	return {
		Line = line,
		Text = text
	}

end

local TOTAL =
	MAX_PLAYER +
	MAX_RESOURCE * 4

for i = 1,TOTAL do
	Pool[i] = MakeESP()
end

local function ESPColor(t)

	if t == "Player" then
		return Color3.fromRGB(0,255,0)
	end

	if t == "Wood" then
		return Color3.fromRGB(170,100,40)
	end

	if t == "Stone" then
		return Color3.fromRGB(200,200,200)
	end

	if t == "Apple" then
		return Color3.fromRGB(255,40,40)
	end

	if t == "Food" then
		return Color3.fromRGB(255,180,0)
	end

	return Color3.new(1,1,1)

end

local function HideESP()

	for _,e in ipairs(Pool) do

		e.Line.Visible = false
		e.Text.Visible = false

	end

end

RunService.RenderStepped:Connect(function()

	if not ESP then

		HideESP()
		return

	end

	local cam =
		workspace.CurrentCamera

	local char =
		LP.Character

	local root =
		char and
		char:FindFirstChild(
			"HumanoidRootPart"
		)

	if not cam or not root then

		HideESP()
		return

	end

	local targets = {}

	for _,d in ipairs(
		PlayersCache
	) do

		table.insert(
			targets,
			d
		)

	end

	for _,list in pairs(Cache) do

		local sorted = {}

		for _,d in ipairs(list) do

			if d.Root
				and d.Root.Parent then

				d.Distance =
					(
						root.Position -
						d.Root.Position
					).Magnitude

				table.insert(
					sorted,
					d
				)

			end

		end

		table.sort(
			sorted,
			function(a,b)
				return a.Distance <
					b.Distance
			end
		)

		for i = 1,
			math.min(
				MAX_RESOURCE,
				#sorted
			) do

			table.insert(
				targets,
				sorted[i]
			)

		end

	end

	local center =
		Vector2.new(
			cam.ViewportSize.X/2,
			cam.ViewportSize.Y/2
		)

	for i = 1,TOTAL do

		local e = Pool[i]
		local d = targets[i]

		if not d
			or not d.Root
			or not d.Root.Parent then

			e.Line.Visible = false
			e.Text.Visible = false
			continue

		end

		local pos =
			cam:WorldToViewportPoint(
				d.Root.Position
			)

		if pos.Z <= 0 then

			e.Line.Visible = false
			e.Text.Visible = false
			continue

		end

		local target =
			Vector2.new(
				pos.X,
				pos.Y
			)

		local diff =
			target - center

		local len =
			diff.Magnitude

		if len > 1 then

			e.Line.Position =
				UDim2.fromOffset(
					(center.X + target.X)/2,
					(center.Y + target.Y)/2
				)

			e.Line.Size =
				UDim2.fromOffset(
					len,
					2
				)

			e.Line.Rotation =
				math.deg(
					math.atan2(
						diff.Y,
						diff.X
					)
				)

			e.Line.BackgroundColor3 =
				ESPColor(d.Type)

			e.Line.Visible = true

		end

		e.Text.Position =
			UDim2.fromOffset(
				math.clamp(
					target.X,
					45,
					cam.ViewportSize.X-45
				),
				math.clamp(
					target.Y-25,
					20,
					cam.ViewportSize.Y-20
				)
			)

		e.Text.TextColor3 =
			ESPColor(d.Type)

		e.Text.Text =
			d.Name..
			"\n"..
			math.floor(
				d.Distance
			).." m"

		e.Text.Visible = true

	end

end)

ESPButton.MouseButton1Click:Connect(function()

	ESP =
		not ESP

	ESPButton.Text =
		ESP
		and "ESP : ON"
		or "ESP : OFF"

	ESPButton.BackgroundColor3 =
		ESP
		and Color3.fromRGB(40,180,40)
		or Color3.fromRGB(50,50,50)

	if not ESP then
		HideESP()
	end

end)

