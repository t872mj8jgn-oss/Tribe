local PowerStroke = Instance.new("UIStroke")
PowerStroke.Thickness = 2
PowerStroke.Color = Color3.fromRGB(255,255,255)
PowerStroke.Parent = SmallPower

local function SetPower(value)

	POWER = value

	PowerButton.Text =
		POWER and "POWER : ON" or "POWER : OFF"

	PowerButton.BackgroundColor3 =
		POWER
		and Color3.fromRGB(40,180,40)
		or Color3.fromRGB(50,50,50)

	SmallPower.Visible = POWER

end

PowerButton.MouseButton1Click:Connect(function()
	SetPower(not POWER)
end)

local function UsePower()

	if not POWER or POWER_COOLDOWN then
		return
	end

	local char = LP.Character

	local root =
		char and char:FindFirstChild("HumanoidRootPart")

	if not root then
		return
	end

	POWER_COOLDOWN = true

	root.CFrame =
		root.CFrame +
		root.CFrame.LookVector * POWER_DISTANCE

	task.delay(2,function()
		POWER_COOLDOWN = false
	end)

end

SmallPower.MouseButton1Click:Connect(UsePower)

--==================================================
-- POWER DRAG / LOCK
--==================================================

local powerDragging = false
local powerDragStart
local powerStartPosition

SmallPower.InputBegan:Connect(function(input)

	if POWER_LOCK then
		return
	end

	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then

		powerDragging = true
		powerDragStart = input.Position
		powerStartPosition = SmallPower.Position

	end

end)

UIS.InputChanged:Connect(function(input)

	if POWER_LOCK or not powerDragging then
		return
	end

	if input.UserInputType ~= Enum.UserInputType.MouseMovement
		and input.UserInputType ~= Enum.UserInputType.Touch then
		return
	end

	local delta = input.Position - powerDragStart

	SmallPower.Position =
		UDim2.new(
			powerStartPosition.X.Scale,
			powerStartPosition.X.Offset + delta.X,
			powerStartPosition.Y.Scale,
			powerStartPosition.Y.Offset + delta.Y
		)

end)

UIS.InputEnded:Connect(function(input)

	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then

		powerDragging = false

	end

end)

