--==================================================
-- CHARACTER
--==================================================

local Character
local Humanoid
local Root
local AntiPart

local function SetupCharacter(char)

	Character = char
	Humanoid = char:WaitForChild("Humanoid")
	Root = char:WaitForChild("HumanoidRootPart")

	LOCKED_Y = nil

	task.wait(0.1)

end

if LP.Character then
	SetupCharacter(LP.Character)
end

LP.CharacterAdded:Connect(function(char)

	SetupCharacter(char)

end)

