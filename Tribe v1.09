--==================================================
-- ANTI WATER PART
--==================================================

local function CreateAntiPart()

	if not Character or not Root then
		return
	end

	if AntiPart then
		AntiPart:Destroy()
	end

	AntiPart = Instance.new("Part")

	AntiPart.Name = "AntiWaterSurface"
	AntiPart.Size = PART_SIZE
	AntiPart.Transparency = 1
	AntiPart.CanCollide = true
	AntiPart.CanTouch = false
	AntiPart.CanQuery = false
	AntiPart.Massless = true
	AntiPart.CastShadow = false
	AntiPart.Anchored = false

	AntiPart.CFrame =
		Root.CFrame * CFrame.new(PART_OFFSET)

	AntiPart.Parent = Character

	local Weld = Instance.new("WeldConstraint")

	Weld.Part0 = Root
	Weld.Part1 = AntiPart
	Weld.Parent = AntiPart

end

--==================================================
-- Y LOCK
--==================================================

local function SetYLock(value)

	Y_LOCK = value

	if Y_LOCK and Root then

		LOCKED_Y = Root.Position.Y

	else

		LOCKED_Y = nil

	end

	YLockButton.Text =
		Y_LOCK
		and "🔒 Y LOCK : ON"
		or "🔒 Y LOCK : OFF"

	YLockButton.BackgroundColor3 =
		Y_LOCK
		and Color3.fromRGB(40,180,40)
		or Color3.fromRGB(50,50,50)

end

YLockButton.MouseButton1Click:Connect(function()

	SetYLock(not Y_LOCK)

end)

