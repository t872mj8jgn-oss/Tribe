--==================================================
-- TAB LOGIC
--==================================================

local function Tab(name)

	ESPPage.Visible = name == "ESP"
	AIMPage.Visible = name == "AIM"
	FarmPage.Visible = name == "FARM"
	PowerPage.Visible = name == "POWER"
	AntiPage.Visible = name == "ANTI"
	MiscPage.Visible = name == "MISC"

	ESPTab.BackgroundColor3 =
		name == "ESP"
		and Color3.fromRGB(0,170,255)
		or Color3.fromRGB(50,50,50)

	AIMTab.BackgroundColor3 =
		name == "AIM"
		and Color3.fromRGB(0,170,255)
		or Color3.fromRGB(50,50,50)

	FarmTab.BackgroundColor3 =
		name == "FARM"
		and Color3.fromRGB(0,170,255)
		or Color3.fromRGB(50,50,50)

	PowerTab.BackgroundColor3 =
		name == "POWER"
		and Color3.fromRGB(0,170,255)
		or Color3.fromRGB(50,50,50)

	AntiTab.BackgroundColor3 =
		name == "ANTI"
		and Color3.fromRGB(0,170,255)
		or Color3.fromRGB(50,50,50)

	MiscTab.BackgroundColor3 =
		name == "MISC"
		and Color3.fromRGB(0,170,255)
		or Color3.fromRGB(50,50,50)

end

ESPTab.MouseButton1Click:Connect(function()
	Tab("ESP")
end)

AIMTab.MouseButton1Click:Connect(function()
	Tab("AIM")
end)

FarmTab.MouseButton1Click:Connect(function()
	Tab("FARM")
end)

PowerTab.MouseButton1Click:Connect(function()
	Tab("POWER")
end)

AntiTab.MouseButton1Click:Connect(function()
	Tab("ANTI")
end)

MiscTab.MouseButton1Click:Connect(function()
	Tab("MISC")
end)

--==================================================
-- HIDE / SHOW
--==================================================

local Show = Instance.new("TextButton")

Show.Size = UDim2.fromOffset(48,48)
Show.Position = UDim2.new(.5,-24,.3,0)
Show.BackgroundColor3 = Color3.fromRGB(40,40,40)
Show.Text = "⚡"
Show.TextColor3 = Color3.new(1,1,1)
Show.TextSize = 21
Show.Font = Enum.Font.GothamBold
Show.BorderSizePixel = 0
Show.Visible = false
Show.Active = true
Show.ZIndex = 900
Show.Parent = Gui

Instance.new("UICorner",Show).CornerRadius =
	UDim.new(0,10)

Hide.MouseButton1Click:Connect(function()

	Main.Visible = false
	Show.Visible = true

end)

Show.MouseButton1Click:Connect(function()

	Main.Visible = true
	Show.Visible = false

end)

--==================================================
-- DRAG
--==================================================

local function Drag(frame)

	local active = false
	local start
	local position

	frame.InputBegan:Connect(function(input)

		if input.UserInputType ==
			Enum.UserInputType.MouseButton1
			or input.UserInputType ==
			Enum.UserInputType.Touch then

			active = true
			start = input.Position
			position = frame.Position

		end

	end)

	UIS.InputChanged:Connect(function(input)

		if not active then
			return
		end

		if input.UserInputType ~=
			Enum.UserInputType.MouseMovement
			and input.UserInputType ~=
			Enum.UserInputType.Touch then
			return
		end

		local delta =
			input.Position-start

		frame.Position =
			UDim2.new(
				position.X.Scale,
				position.X.Offset+delta.X,
				position.Y.Scale,
				position.Y.Offset+delta.Y
			)

	end)

	UIS.InputEnded:Connect(function(input)

		if input.UserInputType ==
			Enum.UserInputType.MouseButton1
			or input.UserInputType ==
			Enum.UserInputType.Touch then

			active = false

		end

	end)

end

Drag(Main)
Drag(Show)
Drag(SmallPower)

