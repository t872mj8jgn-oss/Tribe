WaterWarningLabel.Size =
	UDim2.fromOffset(280,42)

WaterWarningLabel.Position =
	UDim2.new(.5,-140,.12,0)

WaterWarningLabel.BackgroundColor3 =
	Color3.fromRGB(0,120,180)

WaterWarningLabel.BackgroundTransparency = .1

WaterWarningLabel.TextColor3 =
	Color3.new(1,1,1)

WaterWarningLabel.Font =
	Enum.Font.GothamBold

WaterWarningLabel.TextSize = 13

WaterWarningLabel.Text =
	"🌊 KHÔNG CÓ NƯỚC GẦN"

WaterWarningLabel.Visible = false
WaterWarningLabel.ZIndex = 500
WaterWarningLabel.Parent = Gui

Instance.new("UICorner",WaterWarningLabel).CornerRadius =
	UDim.new(0,10)

task.spawn(function()

	while Gui.Parent do

		task.wait(WATER_CHECK)

		if not Root
			or not Root.Parent then

			WaterWarningLabel.Visible = false
			continue

		end

		if not WATER_WARNING then

			WaterWarningLabel.Visible = false
			continue

		end

		local foundWater = false

		local parts =
			workspace:GetPartBoundsInRadius(
				Root.Position,
				WATER_RADIUS
			)

		for _,part in ipairs(parts) do

			if part ~= AntiPart
				and not (
					Character
					and part:IsDescendantOf(Character)
				)
				and IsWaterPart(part) then

				foundWater = true
				break

			end

		end

		if foundWater then

			WaterWarningLabel.Text =
				"⚠️ NƯỚC Ở GẦN!"

			WaterWarningLabel.Visible = true

		else

			WaterWarningLabel.Visible = false

		end

	end

end)

