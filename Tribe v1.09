--==================================================
-- ANTI WATER HEARTBEAT
--==================================================

RunService.Heartbeat:Connect(function()

	if not Character
		or not Character.Parent
		or not Root
		or not Root.Parent
		or not Humanoid then
		return
	end

	-- ANTI SLOW
	if ANTI_SLOW then
		Humanoid.WalkSpeed = ANTI_SPEED
	end

	-- ANTI WATER
	if ANTI_WATER then

		local velocity =
			Root.AssemblyLinearVelocity

		local moveDirection =
			Humanoid.MoveDirection

		local speed =
			Humanoid.WalkSpeed

		local x
		local z

		if moveDirection.Magnitude > 0.01 then

			local direction =
				moveDirection.Unit

			x = direction.X * speed
			z = direction.Z * speed

		else

			x = 0
			z = 0

		end

		-- Khóa Y nếu đang bật
		if Y_LOCK and LOCKED_Y then

			local pos = Root.Position

			Root.CFrame =
				CFrame.new(
					pos.X,
					LOCKED_Y,
					pos.Z
				) *
				Root.CFrame.Rotation

			Root.AssemblyLinearVelocity =
				Vector3.new(
					x,
					0,
					z
				)

		else

			-- Giữ Y bình thường
			Root.AssemblyLinearVelocity =
				Vector3.new(
					x,
					velocity.Y,
					z
				)

		end

	end

end)

--==================================================
-- ANTI WATER PART REFRESH
--==================================================

task.spawn(function()

	while Gui.Parent do

		task.wait(0.05)

		if ANTI_WATER
			and Character
			and Character.Parent
			and Root
			and Root.Parent then

			if not AntiPart
				or not AntiPart.Parent then

				CreateAntiPart()

			end

		end

	end

end)

--==================================================
-- MAP FORCE REMOVER
--==================================================

local function DisableForce(obj)

	if obj:IsA("VectorForce")
		or obj:IsA("LinearVelocity")
		or obj:IsA("AngularVelocity")
		or obj:IsA("BodyVelocity")
		or obj:IsA("BodyForce")
		or obj:IsA("BodyAngularVelocity")
		or obj:IsA("BodyThrust") then

		pcall(function()

			if obj:IsA("BodyVelocity")
				or obj:IsA("BodyForce")
				or obj:IsA("BodyAngularVelocity")
				or obj:IsA("BodyThrust") then

				obj:Destroy()

			else

				obj.Enabled = false

			end

		end)

	end

end

task.spawn(function()

	while Gui.Parent do

		task.wait(FORCE_SCAN)

		if ANTI_MAP_FORCE then

			for _,obj in ipairs(
				workspace:GetDescendants()
			) do

				if Character
					and obj:IsDescendantOf(Character) then
					continue
				end

				DisableForce(obj)

			end

		end

	end

end)

workspace.DescendantAdded:Connect(function(obj)

	if not ANTI_MAP_FORCE then
		return
	end

	task.defer(function()

		if Character
			and obj:IsDescendantOf(Character) then
			return
		end

		DisableForce(obj)

	end)

end)

--==================================================
-- WATER DETECTION
--==================================================

local function IsWaterPart(part)

	if not part:IsA("BasePart") then
		return false
	end

	local name =
		string.lower(part.Name)

	return
		string.find(name,"water") ~= nil
		or string.find(name,"ocean") ~= nil
		or string.find(name,"sea") ~= nil
		or string.find(name,"river") ~= nil
		or string.find(name,"lake") ~= nil

end

