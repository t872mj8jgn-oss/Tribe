		PowerLockButton.BackgroundColor3 =
			Color3.fromRGB(180,50,50)

	else

		PowerLockButton.Text =
			"🔓 POWER POSITION: UNLOCK"

		PowerLockButton.BackgroundColor3 =
			Color3.fromRGB(50,50,50)

	end

end)

