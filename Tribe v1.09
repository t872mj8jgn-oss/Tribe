	ANTI_WATER = not ANTI_WATER

	AntiWaterButton.Text =
		ANTI_WATER
		and "🛡️ ANTI WATER : ON"
		or "🛡️ ANTI WATER : OFF"

	AntiWaterButton.BackgroundColor3 =
		ANTI_WATER
		and Color3.fromRGB(40,180,40)
		or Color3.fromRGB(50,50,50)

	if not ANTI_WATER then

		if AntiPart then
			AntiPart:Destroy()
			AntiPart = nil
		end

		-- Tắt khóa Y khi Anti Water tắt
		Y_LOCK = false
		LOCKED_Y = nil

		YLockButton.Text = "🔒 Y LOCK : OFF"
		YLockButton.BackgroundColor3 =
			Color3.fromRGB(50,50,50)

	end

end)

