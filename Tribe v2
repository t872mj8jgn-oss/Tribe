--============================================================
-- RESOURCE CACHE
--============================================================

local ResourceCache = {
	Wood = {},
	Stone = {},
	Apple = {},
	Food = {}
}

local function getRoot(object)

	if object:IsA("BasePart") then
		return object
	end

	if object:IsA("Model") then

		if object.PrimaryPart then
			return object.PrimaryPart
		end

		return object:FindFirstChildWhichIsA(
			"BasePart",
			true
		)
	end

	return nil
end

--============================================================
-- RESOURCE NAME DETECTION
--============================================================

local function getResourceType(object)

	local n = object.Name:lower()

	-- Wood / Tree
	if n:find("wood")
		or n:find("tree")
		or n:find("log") then
		return "Wood"
	end

	-- Stone / Rock
	if n:find("stone")
		or n:find("rock")
		or n:find("ore") then
		return "Stone"
	end

	-- Apple
	if n:find("apple") then
		return "Apple"
	end

	-- Food
	if n:find("food")
		or n:find("meat")
		or n:find("berry")
		or n:find("fish") then
		return "Food"
	end

	return nil
end

--============================================================
-- RESOURCE SCAN
--============================================================

local function rebuildResourceCache()

	local newCache = {
		Wood = {},
		Stone = {},
		Apple = {},
		Food = {}
	}

	for _,object in ipairs(workspace:GetDescendants()) do

		if object:IsA("BasePart")
			or object:IsA("Model") then

			local resourceType =
				getResourceType(object)

			if resourceType then

				local root = getRoot(object)

				if root
					and root:IsDescendantOf(workspace) then

					table.insert(
						newCache[resourceType],
						{
							Root = root,
							Type = resourceType,
							Name = resourceType
						}
					)

				end
			end
		end
	end

	ResourceCache = newCache

end

--============================================================
-- PLAYER CACHE
--============================================================

local PlayerTargets = {}

local function updatePlayers()

	local char = LP.Character

	local myRoot =
		char
		and char:FindFirstChild("HumanoidRootPart")

	if not myRoot then
		PlayerTargets = {}
		return
	end

	local list = {}

	for _,player in ipairs(Players:GetPlayers()) do

		if player ~= LP then

			local targetChar = player.Character

			local root =
				targetChar
				and targetChar:FindFirstChild(
					"HumanoidRootPart"
				)

			local humanoid =
				targetChar
				and targetChar:FindFirstChildOfClass(
					"Humanoid"
				)

			if root
				and humanoid
				and humanoid.Health > 0 then

				local distance =
					(myRoot.Position-root.Position).Magnitude

				table.insert(list,{
					Root = root,
					Type = "Player",
					Name = player.DisplayName,
					Distance = distance
				})

			end
		end
	end

	table.sort(list,function(a,b)
		return a.Distance < b.Distance
	end)

	PlayerTargets = {}

	for i = 1,math.min(MAX_PLAYERS,#list) do
		PlayerTargets[i] = list[i]
	end

end

--============================================================
-- NEAREST RESOURCE
--============================================================

local function getNearestResources(myRoot)

	local result = {}

	for resourceType,list in pairs(ResourceCache) do

		local sorted = {}

		for _,data in ipairs(list) do

			if data.Root
				and data.Root.Parent then

				local distance =
					(myRoot.Position-data.Root.Position).Magnitude

				table.insert(sorted,{
					Root = data.Root,
					Type = resourceType,
					Name = resourceType,
					Distance = distance
				})

			end
		end

		table.sort(sorted,function(a,b)
			return a.Distance < b.Distance
		end)

		for i = 1,math.min(MAX_RESOURCE,#sorted) do
			table.insert(result,sorted[i])
		end

	end

	return result
end

--============================================================
-- ESP COLOR
--============================================================

local function getColor(data)

	if data.Type == "Player" then
		return Color3.fromRGB(0,255,0)
	end

	if data.Type == "Wood" then
		return Color3.fromRGB(170,100,40)
	end

	if data.Type == "Stone" then
		return Color3.fromRGB(190,190,190)
	end

	if data.Type == "Apple" then
		return Color3.fromRGB(255,50,50)
	end

	if data.Type == "Food" then
		return Color3.fromRGB(255,180,0)
	end

	return Color3.new(1,1,1)
end

