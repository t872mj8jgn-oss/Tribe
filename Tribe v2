local function getFoodTool()

	local containers = {
		LP:FindFirstChild("Backpack"),
		LP.Character
	}

	for _,container in ipairs(containers) do

		if container then

			for _,item in ipairs(container:GetChildren()) do

				if item:IsA("Tool") then

					local n = item.Name:lower()

					if n:find("apple")
						or n:find("meat")
						or n:find("berry")
						or n:find("fish")
						or n:find("food") then

						return item
					end

				end
			end
		end
	end

	return nil
end

local function setEatSpeed(value)

	local n = tonumber(value)

	if not n then
		SpeedBox.Text = tostring(EAT_SPEED)
		return
	end

	EAT_SPEED =
		math.clamp(
			math.floor(n),
			0,
			20
		)

	SpeedBox.Text =
		tostring(EAT_SPEED)

	SpeedLabel.Text =
		"Speed: "
		.. EAT_SPEED
		.. " / 20"

end

SpeedSet.MouseButton1Click:Connect(function()
	setEatSpeed(SpeedBox.Text)
end)

SpeedBox.FocusLost:Connect(function(enterPressed)

	if enterPressed then
		setEatSpeed(SpeedBox.Text)
	else
		SpeedBox.Text = tostring(EAT_SPEED)
	end

end)

