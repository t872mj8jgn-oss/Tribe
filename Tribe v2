RunService.RenderStepped:Connect(function()

	if not AIM_ENABLED
		or not aimTarget then
		return
	end

	local char = LP.Character

	local root =
		char
		and char:FindFirstChild(
			"HumanoidRootPart"
		)

	if not root then
		return
	end

	local targetChar =
		aimTarget.Character

	if not targetChar then
		return
	end

	local targetRoot =
		targetChar:FindFirstChild(
			"HumanoidRootPart"
		)

	if not targetRoot then
		return
	end

	-- AIM NGANG
	local flatTarget =
		Vector3.new(
			targetRoot.Position.X,
			root.Position.Y,
			targetRoot.Position.Z
		)

	if (flatTarget-root.Position).Magnitude > 0.1 then

		root.CFrame =
			CFrame.lookAt(
				root.Position,
				flatTarget
			)

	end

end)

