--============================================================
-- ESP RENDER
--============================================================

RunService.RenderStepped:Connect(function()

	if not ESP_ENABLED then
		return
	end

	local camera = workspace.CurrentCamera

	if not camera then
		hideESP()
		return
	end

	local char = LP.Character

	local myRoot =
		char
		and char:FindFirstChild("HumanoidRootPart")

	if not myRoot then
		hideESP()
		return
	end

	local targets = {}

	for _,data in ipairs(PlayerTargets) do
		table.insert(targets,data)
	end

	for _,data in ipairs(
		getNearestResources(myRoot)
	) do
		table.insert(targets,data)
	end

	local center = Vector2.new(
		camera.ViewportSize.X/2,
		camera.ViewportSize.Y/2
	)

	for i = 1,TOTAL_SLOTS do

		local esp = ESPPool[i]
		local data = targets[i]

		if not data
			or not data.Root
			or not data.Root.Parent then

			esp.Line.Visible = false
			esp.Text.Visible = false

			continue
		end

		local pos,visible =
			camera:WorldToViewportPoint(
				data.Root.Position
			)

		if pos.Z <= 0 then

			esp.Line.Visible = false
			esp.Text.Visible = false

			continue
		end

		local target = Vector2.new(
			pos.X,
			pos.Y
		)

		local difference =
			target-center

		local length =
			difference.Magnitude

		if length > 1 then

			esp.Line.Position =
				UDim2.fromOffset(
					(center.X+target.X)/2,
					(center.Y+target.Y)/2
				)

			esp.Line.Size =
				UDim2.fromOffset(
					length,
					2
				)

			esp.Line.Rotation =
				math.deg(
					math.atan2(
						difference.Y,
						difference.X
					)
				)

			esp.Line.BackgroundColor3 =
				getColor(data)

			esp.Line.Visible = true

		end

		local x = math.clamp(
			target.X,
			50,
			camera.ViewportSize.X-50
		)

		local y = math.clamp(
			target.Y-25,
			20,
			camera.ViewportSize.Y-20
		)

		esp.Text.Position =
			UDim2.fromOffset(x,y)

		esp.Text.TextColor3 =
			getColor(data)

		esp.Text.Text =
			data.Name
			.. "\n"
			.. math.floor(data.Distance)
			.. " m"

		esp.Text.Visible = true

	end

	for i = #targets+1,TOTAL_SLOTS do
		ESPPool[i].Line.Visible = false
		ESPPool[i].Text.Visible = false
	end

end)

