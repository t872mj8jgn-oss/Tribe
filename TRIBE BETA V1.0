local function MakeButton(parent,text,y)

	local b = Instance.new("TextButton")

	b.Size = UDim2.new(1,0,0,35)
	b.Position = UDim2.fromOffset(0,y)

	b.BackgroundColor3 = Color3.fromRGB(55,55,55)

	b.Text = text
	b.TextColor3 = Color3.new(1,1,1)

	b.Font = Enum.Font.GothamBold
	b.TextSize = 12

	b.BorderSizePixel = 0
	b.Parent = parent

	Instance.new("UICorner",b).CornerRadius = UDim.new(0,8)

	return b
end

local function MakeLabel(parent,text,y,h)

	local l = Instance.new("TextLabel")

	l.Size = UDim2.new(1,0,0,h or 20)
	l.Position = UDim2.fromOffset(0,y)

	l.BackgroundTransparency = 1

	l.Text = text
	l.TextColor3 = Color3.fromRGB(190,190,190)

	l.Font = Enum.Font.Gotham
	l.TextSize = 11

	l.TextWrapped = true

	l.Parent = parent

	return l
end

local function SetToggleButton(button,state,onText,offText)

	button.Text = state and onText or offText

	button.BackgroundColor3 =
		state
		and Color3.fromRGB(40,180,40)
		or Color3.fromRGB(180,50,50)
end

