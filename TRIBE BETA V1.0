)

--========================================================
-- FULL BRIGHT + NO FOG
--========================================================

local function UpdateLighting()

	if FULL_BRIGHT then

		Lighting.Brightness = 3
		Lighting.ClockTime = 14
		Lighting.GlobalShadows = false
		Lighting.ExposureCompensation = 0
	end

	if NO_FOG then

		Lighting.FogStart = 0
		Lighting.FogEnd = 100000
	end
end

task.spawn(function()

	while Gui.Parent do

		UpdateLighting()

		task.wait(2)
	end
end)

--========================================================
-- PLAYER WARNING
--========================================================

local Warning = Instance.new("TextLabel")

Warning.Size =
	UDim2.fromOffset(320,45)

Warning.Position =
	UDim2.new(.5,-160,.08,0)

Warning.BackgroundColor3 =
	Color3.fromRGB(170,30,30)

Warning.BackgroundTransparency = .1

Warning.TextColor3 =
	Color3.new(1,1,1)

Warning.Font =
	Enum.Font.GothamBold

Warning.TextSize = 12
Warning.TextWrapped = true

Warning.Text = ""
Warning.Visible = false

Warning.BorderSizePixel = 0
Warning.Parent = Gui

Instance.new("UICorner",Warning)
	.CornerRadius = UDim.new(0,10)

local function CheckWarning()

	if not PLAYER_WARNING then

		Warning.Visible = false

		return
	end

	local char = LP.Character

	local root =
		char and
		char:FindFirstChild(
			"HumanoidRootPart"
		)

	if not root then
		return
	end

	local nearest
	local nearestDistance =
		WARNING_DISTANCE

	for _,p in ipairs(
		Players:GetPlayers()
	) do

		if p ~= LP then

			local c = p.Character

			local r =
				c and
				c:FindFirstChild(
					"HumanoidRootPart"
				)

			if r then

				local d =
					(
						root.Position
						-
						r.Position
					).Magnitude

				if d <= nearestDistance then

					nearest = p
					nearestDistance = d
				end
			end
		end
	end

	if nearest then

		Warning.Text =
			"⚠ PLAYER GẦN\n"
			..nearest.DisplayName
			.." - "
			..math.floor(
				nearestDistance
			)
			.." studs"

		Warning.Visible = true

	else

		Warning.Visible = false
	end
end

task.spawn(function()

	while Gui.Parent do

		CheckWarning()

		task.wait(.25)
	end
end)

