--========================================================
-- TAB SYSTEM
--========================================================

local function Tab(name)

	ESPPage.Visible =
		name == "ESP"

	AIMPage.Visible =
		name == "AIM"

	FarmPage.Visible =
		name == "FARM"

	PowerPage.Visible =
		name == "POWER"

	MiscPage.Visible =
		name == "MISC"

	local tabs = {
		{ESPTab,"ESP"},
		{AIMTab,"AIM"},
		{FarmTab,"FARM"},
		{PowerTab,"POWER"},
		{MiscTab,"MISC"}
	}

	for _,info in ipairs(tabs) do

		info[1].BackgroundColor3 =
			info[2] == name
			and Color3.fromRGB(
				0,170,255
			)
			or Color3.fromRGB(
				50,50,50
			)
	end
end

ESPTab.MouseButton1Click:Connect(
	function()
		Tab("ESP")
	end
)

AIMTab.MouseButton1Click:Connect(
