--========================================================
-- RESOURCE CACHE
--========================================================

local Cache = {
	Wood = {},
	Stone = {},
	Apple = {},
	Food = {}
}

local function GetRoot(obj)

	if obj:IsA("BasePart") then
		return obj
	end

	if obj:IsA("Model") then

		return obj.PrimaryPart
			or obj:FindFirstChildWhichIsA(
				"BasePart",
				true
			)
	end

	return nil
end

local function GetType(obj)

	local n = obj.Name:lower()

	if n:find("wood")
		or n:find("tree")
		or n:find("log") then

		return "Wood"
	end

	if n:find("stone")
		or n:find("rock")
		or n:find("ore") then

		return "Stone"
	end

	if n:find("apple") then
		return "Apple"
	end

	if n:find("food")
		or n:find("meat")
		or n:find("berry")
		or n:find("fish") then

		return "Food"
	end
end

local function ScanResources()

	local new = {
		Wood = {},
		Stone = {},
		Apple = {},
		Food = {}
	}

	for _,obj in ipairs(workspace:GetDescendants()) do

		if obj:IsA("BasePart")
			or obj:IsA("Model") then

			local t = GetType(obj)
			local r = t and GetRoot(obj)

			if t and r then

				table.insert(
					new[t],
					{
						Root = r,
						Type = t,
						Name = t
					}
				)
			end
		end
	end

	Cache = new
end

--========================================================
-- PLAYER CACHE
--========================================================

local PlayersCache = {}

local function ScanPlayers()

	local char = LP.Character

	local root =
		char and
		char:FindFirstChild("HumanoidRootPart")

	if not root then

		PlayersCache = {}

		return
	end

	local list = {}

	for _,p in ipairs(Players:GetPlayers()) do

		if p ~= LP then

			local c = p.Character

			local r =
				c and
				c:FindFirstChild("HumanoidRootPart")

			local h =
				c and
				c:FindFirstChildOfClass("Humanoid")

			if r and h and h.Health > 0 then

				table.insert(
					list,
					{
						Root = r,
						Type = "Player",
						Name = p.DisplayName,
						Player = p,
						Distance =
							(
								root.Position
								-
								r.Position
							).Magnitude
					}
				)
			end
		end
	end

	table.sort(
		list,
		function(a,b)
			return a.Distance < b.Distance
		end
	)

	PlayersCache = {}

	for i = 1, math.min(
		MAX_PLAYER,
		#list
	) do

		PlayersCache[i] = list[i]
	end
end

--========================================================
-- PERIODIC CACHE UPDATE
--========================================================

task.spawn(function()

	while Gui.Parent do

		ScanResources()

		task.wait(RESOURCE_DELAY)
	end
end)

task.spawn(function()

	while Gui.Parent do

		ScanPlayers()

		task.wait(PLAYER_DELAY)
	end
end)

--========================================================
-- FARM
--========================================================

local FarmTypes = {
	"Wood",
	"Stone",
	"Apple",
	"Food",
	"Player"
}

local FarmIndex = 1

Select.MouseButton1Click:Connect(function()

	FarmIndex += 1

	if FarmIndex > #FarmTypes then
		FarmIndex = 1
	end

	FARM_TYPE =
		FarmTypes[FarmIndex]

	Select.Text =
		FARM_TYPE.." ▼"

	SelectLabel.Text =
		"Farm: "..FARM_TYPE
end)

local function GetFarmTarget()

	local char = LP.Character

	local root =
		char and
		char:FindFirstChild(
			"HumanoidRootPart"
		)

	if not root then
		return nil
	end

	local best
	local bestDistance = math.huge

	if FARM_TYPE == "Player" then

		for _,data in ipairs(PlayersCache) do

			if data.Root
				and data.Root.Parent then

				local d =
					(
						root.Position
						-
						data.Root.Position
					).Magnitude

				if d < bestDistance then

					bestDistance = d
					best = data
				end
			end
		end

		return best,bestDistance
	end

	for _,data in ipairs(
		Cache[FARM_TYPE] or {}
	) do

		local r = data.Root

		if r and r.Parent then

			local d =
				(
					root.Position
					-
					r.Position
				).Magnitude

			if d < bestDistance then

				bestDistance = d
				best = data
			end
		end
	end

	return best,bestDistance
end

task.spawn(function()

	while Gui.Parent do

		if AUTO_FARM then

			local char = LP.Character

			local hum =
				char and
				char:FindFirstChildOfClass(
					"Humanoid"
				)

			local root =
				char and
				char:FindFirstChild(
					"HumanoidRootPart"
				)

			if hum and root then

				hum.WalkSpeed =
					FARM_SPEED

				local target,distance =
					GetFarmTarget()

				if target
					and target.Root then

					FarmStatus.Text =
						"Speed: "
						..FARM_SPEED
						.."\nGoing: "
						..FARM_TYPE
						.." | "
						..math.floor(
							distance
						)
						.." studs"

					hum:MoveTo(
						target.Root.Position
					)

				else

					FarmStatus.Text =
						"Speed: "
						..FARM_SPEED
						.."\nKhông tìm thấy "
						..FARM_TYPE
				end
			end
		end

		task.wait(.15)
	end
end)

--========================================================
-- AIM - NEAREST PLAYER
--========================================================

local function FindAimTarget()

	local char = LP.Character

	local root =
		char and
		char:FindFirstChild(
			"HumanoidRootPart"
		)

	if not root then
		return nil
	end

	local best
	local closest = AIM_DISTANCE

	for _,p in ipairs(
		Players:GetPlayers()
	) do

		if p ~= LP then

			local c = p.Character

			local r =
				c and
				c:FindFirstChild(
					"HumanoidRootPart"
				)

			local h =
				c and
				c:FindFirstChildOfClass(
					"Humanoid"
				)

			if r and h and h.Health > 0 then

				local d =
					(
						root.Position
						-
						r.Position
					).Magnitude

				if d <= closest then

					closest = d
					best = p
				end
			end
		end
	end

	return best
end

task.spawn(function()

	while Gui.Parent do

		if AIM then
			AimTarget =
				FindAimTarget()
		else
			AimTarget = nil
		end

		task.wait(.1)
	end
end)

RunService.RenderStepped:Connect(function()

	if not AIM or not AimTarget then
		return
	end

	local char = LP.Character

	local root =
		char and
		char:FindFirstChild(
			"HumanoidRootPart"
		)

	local targetChar =
		AimTarget.Character

	local targetRoot =
		targetChar and
		targetChar:FindFirstChild(
			"HumanoidRootPart"
		)

	if not root or not targetRoot then
		return
	end

	local targetPosition =
		Vector3.new(
			targetRoot.Position.X,
			root.Position.Y,
			targetRoot.Position.Z
		)

	root.CFrame =
		CFrame.lookAt(
			root.Position,
			targetPosition
		)
end)

--========================================================
-- ESP
--========================================================

local Pool = {}

local TOTAL =
	MAX_PLAYER
	+
	MAX_RESOURCE * 4

local function MakeESP()

	local line = Instance.new("Frame")

	line.Size =
		UDim2.fromOffset(0,2)

	line.AnchorPoint =
		Vector2.new(.5,.5)

	line.BackgroundColor3 =
		Color3.new(1,1,1)

	line.BorderSizePixel = 0
	line.Visible = false
	line.Parent = Gui

	local text = Instance.new("TextLabel")

	text.Size =
		UDim2.fromOffset(170,35)

	text.AnchorPoint =
		Vector2.new(.5,.5)

	text.BackgroundTransparency = 1

	text.TextColor3 =
		Color3.new(1,1,1)

	text.TextStrokeTransparency = 0

	text.Font =
		Enum.Font.GothamBold

	text.TextSize = 13

	text.Visible = false
	text.Parent = Gui

	return {
		Line = line,
		Text = text
	}
end

for i = 1,TOTAL do
	Pool[i] = MakeESP()
end

local function ESPColor(t)

	if t == "Player" then

		return Color3.fromRGB(
			0,255,0
		)

	elseif t == "Wood" then

		return Color3.fromRGB(
			170,100,40
		)

	elseif t == "Stone" then

		return Color3.fromRGB(
			200,200,200
		)

	elseif t == "Apple" then

		return Color3.fromRGB(
			255,40,40
		)

	elseif t == "Food" then

		return Color3.fromRGB(
			255,180,0
		)
	end

	return Color3.new(1,1,1)
end

local function HideESP()

	for _,e in ipairs(Pool) do

		e.Line.Visible = false
		e.Text.Visible = false
	end
end

RunService.RenderStepped:Connect(function()

	if not ESP then

		HideESP()

		return
	end

	local cam =
		workspace.CurrentCamera

	local char = LP.Character

	local root =
		char and
		char:FindFirstChild(
			"HumanoidRootPart"
		)

	if not cam or not root then

		HideESP()

		return
	end

	local targets = {}

	for _,d in ipairs(
		PlayersCache
	) do

		table.insert(
			targets,
			d
		)
	end

	for _,list in pairs(Cache) do

		local sorted = {}

		for _,d in ipairs(list) do

			if d.Root
				and d.Root.Parent then

				d.Distance =
					(
						root.Position
						-
						d.Root.Position
					).Magnitude

				table.insert(
					sorted,
					d
				)
			end
		end

		table.sort(
			sorted,
			function(a,b)
				return a.Distance
					<
					b.Distance
			end
		)

		for i = 1,
			math.min(
				MAX_RESOURCE,
				#sorted
			) do

			table.insert(
				targets,
				sorted[i]
			)
		end
	end

	local center =
		Vector2.new(
			cam.ViewportSize.X/2,
			cam.ViewportSize.Y/2
		)

	for i = 1,TOTAL do

		local e = Pool[i]
		local d = targets[i]

		if not d
			or not d.Root
			or not d.Root.Parent then

			e.Line.Visible = false
			e.Text.Visible = false

			continue
		end

		local pos =
			cam:WorldToViewportPoint(
				d.Root.Position
			)

		if pos.Z <= 0 then

			e.Line.Visible = false
			e.Text.Visible = false

			continue
		end

		local target =
			Vector2.new(
				pos.X,
				pos.Y
			)

		local diff =
			target-center

		local len =
			diff.Magnitude

		e.Line.Position =
			UDim2.fromOffset(
				(
					center.X
					+
					target.X
				)/2,
				(
					center.Y
					+
					target.Y
				)/2
			)

		e.Line.Size =
			UDim2.fromOffset(
				len,
				2
			)

		e.Line.Rotation =
			math.deg(
				math.atan2(
					diff.Y,
					diff.X
				)
			)

		e.Line.BackgroundColor3 =
			ESPColor(d.Type)

		e.Line.Visible = true

		e.Text.Position =
			UDim2.fromOffset(
				math.clamp(
					target.X,
					45,
					cam.ViewportSize.X-45
				),
				math.clamp(
					target.Y-25,
					20,
					cam.ViewportSize.Y-20
				)
			)

		e.Text.TextColor3 =
			ESPColor(d.Type)

		e.Text.Text =
			d.Name
			.."\n"
			..math.floor(
				d.Distance
			)
			.." studs"

		e.Text.Visible = true
	end
end)

--========================================================
-- POWER
--========================================================

local function ActivatePower()

	if not POWER then
		return
	end

	if not PowerReady then
		return
	end

	if POWER_LOCK then
		return
	end

	local char = LP.Character

	local root =
		char and
		char:FindFirstChild(
			"HumanoidRootPart"
		)

	if not root then
		return
	end

	local direction =
		root.CFrame.LookVector

	local destination =
		root.Position
		+
		direction
		*
		POWER_DISTANCE

	root.CFrame =
		CFrame.new(
			destination,
			destination + direction
		)

	PowerReady = false

	PowerStatus.Text =
		"Cooldown: 2 giây\nĐang hồi..."

	task.delay(
		POWER_COOLDOWN,
		function()

			PowerReady = true

			if Gui.Parent then

				PowerStatus.Text =
					"Cooldown: 2 giây\nPower sẵn sàng"
			end
		end
	)
end

PowerFloat.MouseButton1Click:Connect(
	ActivatePower
)

--========================================================
-- SLIDERS
--========================================================

local AimDragging = false
local SpeedDragging = false
local PowerDragging = false

--========================================================
-- AIM 1 - 60m
--========================================================

local function SetAIM(x)

	local left =
		AIMSlider.AbsolutePosition.X

	local width =
		AIMSlider.AbsoluteSize.X

	if width <= 0 then
		return
	end

	local s =
		math.clamp(
			(x-left)/width,
			0,
			1
		)

	AIMKnob.Position =
		UDim2.new(
			s,
			-10,
			0,
			0
		)

	AIM_DISTANCE =
		math.floor(
			1+s*59
		)

	AIMLabel.Text =
		"AIM gần nhất: "
		..AIM_DISTANCE
		.."m"
end

--========================================================
-- SPEED 16 - 20
--========================================================

local function SetSpeed(x)

	local left =
		SpeedSlider.AbsolutePosition.X

	local width =
		SpeedSlider.AbsoluteSize.X

	if width <= 0 then
		return
	end

	local s =
		math.clamp(
			(x-left)/width,
			0,
			1
		)

	SpeedKnob.Position =
		UDim2.new(
			s,
			-10,
			0,
			0
		)

	FARM_SPEED =
		math.floor(
			16+s*4
		)

	SpeedLabel.Text =
		"Speed: "
		..FARM_SPEED
end

--========================================================
-- POWER 10 - 30
--========================================================

local function SetPower(x)

	local left =
		PowerSlider.AbsolutePosition.X

	local width =
		PowerSlider.AbsoluteSize.X

	if width <= 0 then
		return
	end

	local s =
		math.clamp(
			(x-left)/width,
			0,
			1
		)

	PowerKnob.Position =
		UDim2.new(
			s,
			-10,
			0,
			0
		)

	POWER_DISTANCE =
		math.floor(
			10+s*20
		)

	PowerLabel.Text =
		"Power: "
		..POWER_DISTANCE
		.." studs"
end

