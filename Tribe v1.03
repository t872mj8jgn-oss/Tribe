task.spawn(function()

	while Gui.Parent do

		ScanResources()

		task.wait(
			RESOURCE_DELAY
		)
	end
end)

--==================================================
-- PLAYER SCANNER
--==================================================

task.spawn(function()

	while Gui.Parent do

		ScanPlayers()

		task.wait(
			PLAYER_DELAY
		)
	end
end)

--==================================================
-- ESP RENDER
--==================================================

RunService.RenderStepped:Connect(function()

	if not ESP then

		HideESP()

		return
	end

	local cam =
		workspace.CurrentCamera

	local char =
		LP.Character

	local root =
		char and
		char:FindFirstChild(
			"HumanoidRootPart"
		)

	if not cam or not root then

		HideESP()

		return
	end

	local targets = {}

	for _,d in ipairs(
		PlayersCache
	) do

		table.insert(
			targets,
			d
		)
	end

	for _,list in pairs(Cache) do

		local sorted = {}

		for _,d in ipairs(list) do

			if d.Root
				and d.Root.Parent then

				d.Distance =
					(
						root.Position
						-
						d.Root.Position
					).Magnitude

				table.insert(
					sorted,
					d
				)
			end
		end

		table.sort(
			sorted,
			function(a,b)
				return a.Distance <
					b.Distance
			end
		)

		for i=1,
			math.min(
				MAX_RESOURCE,
				#sorted
			) do

			table.insert(
				targets,
				sorted[i]
			)
		end
	end

	local center =
		Vector2.new(
			cam.ViewportSize.X/2,
			cam.ViewportSize.Y/2
		)

	for i=1,TOTAL do

		local e =
			Pool[i]

		local d =
			targets[i]

		if not d
			or not d.Root
			or not d.Root.Parent then

			e.Line.Visible = false
			e.Text.Visible = false

			continue
		end

		local pos =
			cam:WorldToViewportPoint(
				d.Root.Position
			)

		if pos.Z <= 0 then

			e.Line.Visible = false
			e.Text.Visible = false

			continue
		end

		local target =
			Vector2.new(
				pos.X,
				pos.Y
			)

		local diff =
			target-center

		local len =
			diff.Magnitude

		if len > 1 then

			e.Line.Position =
				UDim2.fromOffset(
					(center.X+target.X)/2,
					(center.Y+target.Y)/2
				)

			e.Line.Size =
				UDim2.fromOffset(
					len,
					2
				)

			e.Line.Rotation =
				math.deg(
					math.atan2(
						diff.Y,
						diff.X
					)
				)

			e.Line.BackgroundColor3 =
				ESPColor(d.Type)

			e.Line.Visible = true
		end

		e.Text.Position =
			UDim2.fromOffset(
				math.clamp(
					target.X,
					45,
					cam.ViewportSize.X-45
				),
				math.clamp(
					target.Y-25,
					20,
					cam.ViewportSize.Y-20
				)
			)

		e.Text.TextColor3 =
			ESPColor(d.Type)

		e.Text.Text =
			d.Name
			..
			"\n"
			..
			math.floor(
				d.Distance
			)
			..
			" m"

		e.Text.Visible = true
	end
end)

