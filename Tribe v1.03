--==================================================
-- AIM
--==================================================

local function FindAimTarget()

	local char =
		LP.Character

	local root =
		char and
		char:FindFirstChild(
			"HumanoidRootPart"
		)

	if not root then
		return
	end

	local best
	local dist = AIM_FOV

	for _,p in ipairs(
		Players:GetPlayers()
	) do

		if p ~= LP then

			local c =
				p.Character

			local r =
				c and
				c:FindFirstChild(
					"HumanoidRootPart"
				)

			local h =
				c and
				c:FindFirstChildOfClass(
					"Humanoid"
				)

			if r and h and h.Health > 0 then

				local d =
					(
						root.Position
						-
						r.Position
					).Magnitude

				if d < dist then

					dist = d
					best = p
				end
			end
		end
	end

	return best
end

AIMButton.MouseButton1Click:Connect(function()

	AIM = not AIM

	AIMButton.Text =
		AIM
		and "AIM : ON"
		or "AIM : OFF"

	AIMButton.BackgroundColor3 =
		AIM
		and Color3.fromRGB(
			40,180,40
		)
		or Color3.fromRGB(
			180,50,50
		)

	AIMStatus.Text =
		AIM
		and "Target nearest player"
		or "Disabled"
end)

task.spawn(function()

	while Gui.Parent do

		if AIM then

			AimTarget =
				FindAimTarget()

		else

			AimTarget = nil
		end

		task.wait(.2)
	end
end)

RunService.RenderStepped:Connect(function()

	if not AIM
		or not AimTarget then

		return
	end

	local char =
		LP.Character

	local root =
		char and
		char:FindFirstChild(
			"HumanoidRootPart"
		)

	local c =
		AimTarget.Character

	local tr =
		c and
		c:FindFirstChild(
			"HumanoidRootPart"
		)

	if not root or not tr then
		return
	end

	local pos =
		Vector3.new(
			tr.Position.X,
			root.Position.Y,
			tr.Position.Z
		)

	if
		(
			pos-root.Position
		).Magnitude > .1 then

		root.CFrame =
			CFrame.lookAt(
				root.Position,
				pos
			)
	end
end)

--==================================================
-- AIM FOV SLIDER
--==================================================

local sliderDragging = false

local function SetFOV(x)

	local left =
		Slider.AbsolutePosition.X

	local width =
		Slider.AbsoluteSize.X

	if width <= 0 then
		return
	end

	local scale =
		math.clamp(
			(x-left)/width,
			0,
			1
		)

	Knob.Position =
		UDim2.new(
			scale,
			-10,
			0,
			0
		)

	AIM_FOV =
		math.floor(
			scale*2000
		)

	FOV.Text =
		"FOV: "
		..AIM_FOV
end

Slider.InputBegan:Connect(function(input)

	if input.UserInputType ==
		Enum.UserInputType.MouseButton1

		or input.UserInputType ==
		Enum.UserInputType.Touch then

		sliderDragging = true

		SetFOV(
			input.Position.X
		)
	end
end)

Knob.InputBegan:Connect(function(input)

	if input.UserInputType ==
		Enum.UserInputType.MouseButton1

		or input.UserInputType ==
		Enum.UserInputType.Touch then

		sliderDragging = true
	end
end)

UIS.InputChanged:Connect(function(input)

	if not sliderDragging then
		return
	end

	if input.UserInputType ==
		Enum.UserInputType.MouseMovement

		or input.UserInputType ==
		Enum.UserInputType.Touch then

		SetFOV(
			input.Position.X
		)
	end
end)

UIS.InputEnded:Connect(function(input)

	if input.UserInputType ==
		Enum.UserInputType.MouseButton1

		or input.UserInputType ==
		Enum.UserInputType.Touch then

		sliderDragging = false
	end
end)

