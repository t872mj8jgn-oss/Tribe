--==================================================
-- RESOURCE DATA
--==================================================

local Cache = {
	Wood = {},
	Stone = {},
	Apple = {},
	Food = {}
}

local function GetRoot(obj)

	if obj:IsA("BasePart") then
		return obj
	end

	if obj:IsA("Model") then

		return obj.PrimaryPart
			or obj:FindFirstChildWhichIsA(
				"BasePart",
				true
			)
	end
end

local function GetType(obj)

	local n = obj.Name:lower()

	if n:find("wood")
		or n:find("tree")
		or n:find("log") then

		return "Wood"
	end

	if n:find("stone")
		or n:find("rock")
		or n:find("ore") then

		return "Stone"
	end

	if n:find("apple") then
		return "Apple"
	end

	if n:find("food")
		or n:find("meat")
		or n:find("berry")
		or n:find("fish") then

		return "Food"
	end
end

local function ScanResources()

	local new = {
		Wood = {},
		Stone = {},
		Apple = {},
		Food = {}
	}

	for _,obj in ipairs(workspace:GetDescendants()) do

		if obj:IsA("BasePart")
			or obj:IsA("Model") then

			local t = GetType(obj)
			local r = t and GetRoot(obj)

			if t and r then

				table.insert(
					new[t],
					{
						Root = r,
						Type = t,
						Name = t
					}
				)
			end
		end
	end

	Cache = new
end

--==================================================
-- FIND FARM TARGET
--==================================================

local function GetFarmTarget()

	local char = LP.Character

	local myRoot =
		char and
		char:FindFirstChild(
			"HumanoidRootPart"
		)

	if not myRoot then
		return nil
	end

	local best
	local bestDistance = math.huge

	for _,data in ipairs(
		Cache[FARM_TYPE] or {}
	) do

		local r = data.Root

		if r and r.Parent then

			local d =
				(
					myRoot.Position
					-
					r.Position
				).Magnitude

			if d < bestDistance then

				bestDistance = d
				best = data
			end
		end
	end

	return best,bestDistance
end

--==================================================
-- FARM
--==================================================

local function SetFarm(value)

	AUTO_FARM = value

	FarmButton.Text =
		AUTO_FARM
		and "AUTO FARM : ON"
		or "AUTO FARM : OFF"

	FarmButton.BackgroundColor3 =
		AUTO_FARM
		and Color3.fromRGB(40,180,40)
		or Color3.fromRGB(180,50,50)

	if not AUTO_FARM then

		FarmStatus.Text =
			"Speed: 16\nStopped"
	end
end

FarmButton.MouseButton1Click:Connect(function()

	SetFarm(not AUTO_FARM)

end)

local FarmTypes = {
	"Wood",
	"Stone",
	"Apple",
	"Food"
}

local FarmIndex = 1

Select.MouseButton1Click:Connect(function()

	FarmIndex += 1

	if FarmIndex > #FarmTypes then
		FarmIndex = 1
	end

	FARM_TYPE = FarmTypes[FarmIndex]

	Select.Text =
		FARM_TYPE.." ▼"

	SelectLabel.Text =
		"Farm: "..FARM_TYPE
end)

task.spawn(function()

	while Gui.Parent do

		if AUTO_FARM then

			local char = LP.Character

			local humanoid =
				char and
				char:FindFirstChildOfClass(
					"Humanoid"
				)

			local root =
				char and
				char:FindFirstChild(
					"HumanoidRootPart"
				)

			if humanoid and root then

				humanoid.WalkSpeed =
					FARM_SPEED

				local target,distance =
					GetFarmTarget()

				if target and target.Root then

					FarmStatus.Text =
						"Speed: 16\n"
						.."Going to "
						..FARM_TYPE
						.." | "
						..math.floor(distance)
						.."m"

					humanoid:MoveTo(
						target.Root.Position
					)

					if distance < 5 then

						FarmStatus.Text =
							"Speed: 16\n"
							.."Reached "
							..FARM_TYPE
					end

				else

					FarmStatus.Text =
						"Speed: 16\n"
						.."No "
						..FARM_TYPE
						.." found"
				end
			end
		end

		task.wait(.15)
	end
end)

