--==================================================
-- FULL BRIGHT / NO FOG
--==================================================

local DefaultLighting = {
	Brightness = Lighting.Brightness,
	ExposureCompensation =
		Lighting.ExposureCompensation,
	FogStart = Lighting.FogStart,
	FogEnd = Lighting.FogEnd
}

local function UpdateLighting()

	if FULL_BRIGHT then

		Lighting.Brightness = 3
		Lighting.ExposureCompensation = 2

	else

		Lighting.Brightness =
			DefaultLighting.Brightness

		Lighting.ExposureCompensation =
			DefaultLighting.ExposureCompensation
	end

	if NO_FOG then

		Lighting.FogStart = 100000
		Lighting.FogEnd = 100000

	else

		Lighting.FogStart =
			DefaultLighting.FogStart

		Lighting.FogEnd =
			DefaultLighting.FogEnd
	end
end

task.spawn(function()

	while Gui.Parent do

		UpdateLighting()

		task.wait(1)
	end
end)

--==================================================
-- PLAYER WARNING 30M
--==================================================

task.spawn(function()

	while Gui.Parent do

		if PLAYER_WARNING then

			local char =
				LP.Character

			local root =
				char and
				char:FindFirstChild(
					"HumanoidRootPart"
				)

			local nearest = nil
			local nearestDistance =
				WARNING_DISTANCE

			if root then

				for _,p in ipairs(
					Players:GetPlayers()
				) do

					if p ~= LP then

						local c =
							p.Character

						local r =
							c and
							c:FindFirstChild(
								"HumanoidRootPart"
							)

						local h =
							c and
							c:FindFirstChildOfClass(
								"Humanoid"
							)

						if r and h
							and h.Health > 0 then

							local distance =
								(
									root.Position
									-
									r.Position
								).Magnitude

							if distance <=
								nearestDistance then

								nearestDistance =
									distance

								nearest = p
							end
						end
					end
				end
			end

			if nearest then

				Warning.Visible = true

				Warning.Text =
					"⚠ PLAYER GẦN!\n"
					..
					nearest.DisplayName
					..
					" - "
					..
					math.floor(
						nearestDistance
					)
					..
					"m"

			else

				Warning.Visible = false
			end

		else

			Warning.Visible = false
		end

		task.wait(.25)
	end
end)

