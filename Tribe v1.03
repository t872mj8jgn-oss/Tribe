--==================================================
-- DRAG
--==================================================

local function Drag(frame)

	local active = false
	local start
	local pos

	frame.InputBegan:Connect(function(input)

		if input.UserInputType ==
			Enum.UserInputType.MouseButton1

			or input.UserInputType ==
			Enum.UserInputType.Touch then

			active = true
			start = input.Position
			pos = frame.Position

			input.Changed:Connect(function()

				if input.UserInputState ==
					Enum.UserInputState.End then

					active = false
				end
			end)
		end
	end)

	UIS.InputChanged:Connect(function(input)

		if not active then
			return
		end

		if input.UserInputType ~=
			Enum.UserInputType.MouseMovement

			and input.UserInputType ~=
			Enum.UserInputType.Touch then

			return
		end

		local d =
			input.Position-start

		frame.Position =
			UDim2.new(
				pos.X.Scale,
				pos.X.Offset+d.X,
				pos.Y.Scale,
				pos.Y.Offset+d.Y
			)
	end)
end

Drag(Main)
Drag(Show)

--==================================================
-- PLAYER ESP
--==================================================

local PlayersCache = {}

local function ScanPlayers()

	local char = LP.Character

	local root =
		char and
		char:FindFirstChild(
			"HumanoidRootPart"
		)

	if not root then

		PlayersCache = {}

		return
	end

	local list = {}

	for _,p in ipairs(
		Players:GetPlayers()
	) do

		if p ~= LP then

			local c = p.Character

			local r =
				c and
				c:FindFirstChild(
					"HumanoidRootPart"
				)

			local h =
				c and
				c:FindFirstChildOfClass(
					"Humanoid"
				)

			if r and h and h.Health > 0 then

				table.insert(
					list,
					{
						Root = r,
						Type = "Player",
						Name = p.DisplayName,

						Distance =
							(
								root.Position
								-
								r.Position
							).Magnitude
					}
				)
			end
		end
	end

	table.sort(
		list,
		function(a,b)
			return a.Distance < b.Distance
		end
	)

	PlayersCache = {}

	for i=1,
		math.min(
			MAX_PLAYER,
			#list
		) do

		PlayersCache[i] =
			list[i]
	end
end

--==================================================
-- ESP POOL
--==================================================

local Pool = {}

local function MakeESP()

	local line = Instance.new("Frame")

	line.Size =
		UDim2.fromOffset(0,2)

	line.AnchorPoint =
		Vector2.new(.5,.5)

	line.BackgroundColor3 =
		Color3.new(1,1,1)

	line.BorderSizePixel = 0
	line.Visible = false
	line.Parent = Gui

	local text = Instance.new("TextLabel")

	text.Size =
		UDim2.fromOffset(170,35)

	text.AnchorPoint =
		Vector2.new(.5,.5)

	text.BackgroundTransparency = 1

	text.TextColor3 =
		Color3.new(1,1,1)

	text.TextStrokeTransparency = 0

	text.Font =
		Enum.Font.GothamBold

	text.TextSize = 13

	text.Visible = false
	text.Parent = Gui

	return {
		Line = line,
		Text = text
	}
end

local TOTAL =
	MAX_PLAYER
	+
	MAX_RESOURCE * 4

for i=1,TOTAL do

	Pool[i] =
		MakeESP()
end

local function ESPColor(t)

	if t == "Player" then

		return Color3.fromRGB(
			0,255,0
		)

	elseif t == "Wood" then

		return Color3.fromRGB(
			170,100,40
		)

	elseif t == "Stone" then

		return Color3.fromRGB(
			200,200,200
		)

	elseif t == "Apple" then

		return Color3.fromRGB(
			255,40,40
		)

	elseif t == "Food" then

		return Color3.fromRGB(
			255,180,0
		)
	end

	return Color3.new(1,1,1)
end

local function HideESP()

	for _,e in ipairs(Pool) do

		e.Line.Visible = false
		e.Text.Visible = false
	end
end

