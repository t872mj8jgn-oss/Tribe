-- WARNING 30 STUDS
--==================================================

local WarningGui = Instance.new("TextLabel")

WarningGui.Size =
	UDim2.fromOffset(280,48)

WarningGui.Position =
	UDim2.new(.5,-140,.08,0)

WarningGui.BackgroundColor3 =
	Color3.fromRGB(180,50,50)

WarningGui.TextColor3 =
	Color3.new(1,1,1)

WarningGui.Font =
	Enum.Font.GothamBold

WarningGui.TextSize = 13
WarningGui.TextWrapped = true

WarningGui.Visible = false
WarningGui.BorderSizePixel = 0
WarningGui.Parent = Gui

Instance.new("UICorner",WarningGui)
	.CornerRadius = UDim.new(0,10)

WarningButton.MouseButton1Click:Connect(function()

	WARNING =
		not WARNING

	WarningButton.Text =
		WARNING
		and "⚠ WARNING 30m : ON"
		or "⚠ WARNING 30m : OFF"

	WarningButton.BackgroundColor3 =
		WARNING
		and Color3.fromRGB(40,180,40)
		or Color3.fromRGB(180,50,50)

	if not WARNING then
		WarningGui.Visible = false
	end
end)

task.spawn(function()

	while Gui.Parent do

		if WARNING then

			local char =
				LP.Character

			local root =
				char and char:FindFirstChild(
					"HumanoidRootPart"
				)

			local closest
			local closestDistance =
				WARNING_DISTANCE

			if root then

				for _,p in ipairs(
					Players:GetPlayers()
				) do

					if p ~= LP then

						local c =
							p.Character

						local r =
							c and c:FindFirstChild(
								"HumanoidRootPart"
							)

						if r then

							local distance =
								(
									root.Position -
									r.Position
								).Magnitude

							if distance <=
								closestDistance then

								closestDistance =
									distance

								closest = p
							end
						end
					end
				end
			end

			if closest then

				WarningGui.Text =
					"⚠ "..closest.DisplayName..
					" ở gần!\n"..
					math.floor(
						closestDistance
					)..
					" studs"

				WarningGui.Visible = true

			else

				WarningGui.Visible = false
			end

		else

			WarningGui.Visible = false
		end

		task.wait(.25)
	end
end)

