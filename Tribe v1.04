		or Color3.fromRGB(180,50,50)
end)

PlayerFarmButton.MouseButton1Click:Connect(function()

	PLAYER_FARM =
		not PLAYER_FARM

	PlayerFarmButton.Text =
		PLAYER_FARM
		and "AUTO FARM PLAYER : ON"
		or "AUTO FARM PLAYER : OFF"

