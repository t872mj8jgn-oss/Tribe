		or Color3.fromRGB(180,50,50)

	if not ESP then
		HideESP()
	end
end)

--==================================================
-- AIM - NEAREST PLAYER
--==================================================

local function FindAimTarget()

	local camera =
		workspace.CurrentCamera

	if not camera then
		return nil
	end

	local center =
		Vector2.new(
			camera.ViewportSize.X/2,
			camera.ViewportSize.Y/2
		)

	local best
	local bestFOV =
		AIM_FOV

	for _,p in ipairs(
		Players:GetPlayers()
	) do

		if p ~= LP then

			local c =
				p.Character

			local root =
				c and c:FindFirstChild(
					"HumanoidRootPart"
				)

			local humanoid =
				c and c:FindFirstChildOfClass(
					"Humanoid"
				)

			if root
				and humanoid
				and humanoid.Health > 0 then

				local screen,visible =
					camera:WorldToViewportPoint(
						root.Position
					)

				if visible
					and screen.Z > 0 then

					local point =
						Vector2.new(
							screen.X,
							screen.Y
						)

					local fov =
						(point-center).Magnitude

					if fov < bestFOV then

						bestFOV = fov
						best = p
					end
				end
			end
		end
	end

	return best
end

AIMButton.MouseButton1Click:Connect(function()

	AIM =
		not AIM

	AIMButton.Text =
		AIM
		and "AIM : ON"
		or "AIM : OFF"

	AIMButton.BackgroundColor3 =
		AIM
		and Color3.fromRGB(40,180,40)
		or Color3.fromRGB(180,50,50)
end)

task.spawn(function()

	while Gui.Parent do

		if AIM then

			AimTarget =
				FindAimTarget()

		else

			AimTarget = nil
		end

		task.wait(.1)
	end
end)

-- AIM CAMERA
RunService.RenderStepped:Connect(function()

	if not AIM
		or not AimTarget then

		return
	end

	local camera =
		workspace.CurrentCamera

	local c =
		AimTarget.Character

	local root =
		c and c:FindFirstChild(
			"HumanoidRootPart"
		)

	if not camera
		or not root then

		return
	end

	camera.CFrame =
		CFrame.lookAt(
			camera.CFrame.Position,
			root.Position
		)
end)

--==================================================
-- FULL BRIGHT
--==================================================

local SavedLighting = {}

local function ApplyBright()

	if FULL_BRIGHT then

		SavedLighting.Brightness =
			Lighting.Brightness

		SavedLighting.ClockTime =
			Lighting.ClockTime

		SavedLighting.GlobalShadows =
			Lighting.GlobalShadows

		Lighting.Brightness = 3
		Lighting.ClockTime = 14
		Lighting.GlobalShadows = false

	else

		if SavedLighting.Brightness then

			Lighting.Brightness =
				SavedLighting.Brightness
		end

		if SavedLighting.ClockTime then

			Lighting.ClockTime =
				SavedLighting.ClockTime
		end

		if SavedLighting.GlobalShadows ~= nil then

			Lighting.GlobalShadows =
				SavedLighting.GlobalShadows
		end
	end
end

BrightButton.MouseButton1Click:Connect(function()

	FULL_BRIGHT =
		not FULL_BRIGHT

	BrightButton.Text =
		FULL_BRIGHT
		and "☀ FULL BRIGHT : ON"
		or "☀ FULL BRIGHT : OFF"

	BrightButton.BackgroundColor3 =
		FULL_BRIGHT
		and Color3.fromRGB(40,180,40)
		or Color3.fromRGB(180,50,50)

	ApplyBright()
end)

--==================================================
-- NO FOG
--==================================================

local FogObjects = {}

local function ApplyFog()

	if NO_FOG then

		for _,obj in ipairs(
			Lighting:GetChildren()
		) do

			if obj:IsA("Atmosphere") then

				FogObjects[obj] = {
					Density = obj.Density,
					Haze = obj.Haze
				}

				obj.Density = 0
				obj.Haze = 0
			end
		end

	else

		for obj,data in pairs(
			FogObjects
		) do

			if obj
				and obj.Parent then

				obj.Density =
					data.Density

				obj.Haze =
					data.Haze
			end
		end

		FogObjects = {}
	end
end

FogButton.MouseButton1Click:Connect(function()

	NO_FOG =
		not NO_FOG

	FogButton.Text =
		NO_FOG
		and "🌫 NO FOG : ON"
		or "🌫 NO FOG : OFF"

	FogButton.BackgroundColor3 =
		NO_FOG
		and Color3.fromRGB(40,180,40)
		or Color3.fromRGB(180,50,50)

	ApplyFog()
end)

