end)

--==================================================
-- POWER FLOAT DRAG
--==================================================

local powerButtonDragging = false
local powerStart
local powerStartPos
local powerMoved = false

PowerFloat.InputBegan:Connect(function(input)

	if POWER_LOCKED then
		return
	end

	if input.UserInputType ==
		Enum.UserInputType.MouseButton1
		or input.UserInputType ==
		Enum.UserInputType.Touch then

		powerButtonDragging = true
		powerMoved = false

		powerStart =
			input.Position

		powerStartPos =
			PowerFloat.Position
	end
end)

UIS.InputChanged:Connect(function(input)

	if not powerButtonDragging
		or POWER_LOCKED then
		return
	end

	if input.UserInputType ==
		Enum.UserInputType.MouseMovement
		or input.UserInputType ==
		Enum.UserInputType.Touch then

		local delta =
			input.Position -
			powerStart

		if delta.Magnitude > 8 then
			powerMoved = true
		end

		PowerFloat.Position =
			UDim2.new(
				powerStartPos.X.Scale,
				powerStartPos.X.Offset + delta.X,
				powerStartPos.Y.Scale,
				powerStartPos.Y.Offset + delta.Y
			)
	end
end)

UIS.InputEnded:Connect(function(input)

	if input.UserInputType ==
		Enum.UserInputType.MouseButton1
		or input.UserInputType ==
		Enum.UserInputType.Touch then

		powerButtonDragging = false
	end
end)

--==================================================
-- POWER ACTION
--==================================================

PowerFloat.Activated:Connect(function()

	if powerMoved then
		powerMoved = false
		return
	end

	if not POWER then
		return
	end

	local char =
		LP.Character

	local root =
		char and char:FindFirstChild(
			"HumanoidRootPart"
		)

	if not root then
		return
	end

	root.CFrame =
		root.CFrame +
		root.CFrame.LookVector *
		POWER_DISTANCE
end)

PowerButton.MouseButton1Click:Connect(function()

	POWER =
		not POWER

	PowerButton.Text =
		POWER
		and "⚡ POWER : ON"
		or "⚡ POWER : OFF"

	PowerButton.BackgroundColor3 =
		POWER
		and Color3.fromRGB(40,180,40)
		or Color3.fromRGB(180,50,50)

	PowerFloat.Visible =
		POWER
end)

--==================================================
-- RESOURCE CACHE
--==================================================

local Cache = {
	Wood = {},
	Stone = {},
	Apple = {},
	Food = {}
}

local function GetRoot(obj)

	if obj:IsA("BasePart") then
		return obj
	end

	if obj:IsA("Model") then

		return obj.PrimaryPart
			or obj:FindFirstChildWhichIsA(
				"BasePart",
				true
			)
	end
end

local function GetType(obj)

	local n =
		obj.Name:lower()

	if n:find("wood")
		or n:find("tree")
		or n:find("log") then

		return "Wood"
	end

	if n:find("stone")
		or n:find("rock")
		or n:find("ore") then

		return "Stone"
	end

	if n:find("apple") then
		return "Apple"
	end

	if n:find("food")
		or n:find("meat")
		or n:find("berry")
		or n:find("fish") then

		return "Food"
	end
end

local function ScanResources()

	local new = {
		Wood = {},
		Stone = {},
		Apple = {},
		Food = {}
	}

	for _,obj in ipairs(
		workspace:GetDescendants()
	) do

		if obj:IsA("BasePart")
			or obj:IsA("Model") then

			local t =
				GetType(obj)

			local r =
				t and GetRoot(obj)

			if t and r then

				table.insert(
					new[t],
					{
						Root = r,
						Type = t,
						Name = t
					}
				)
			end
		end
	end

	Cache = new
end

--==================================================
-- PLAYER CACHE
--==================================================

local PlayersCache = {}

local function ScanPlayers()

	local char =
		LP.Character

	local root =
		char and char:FindFirstChild(
			"HumanoidRootPart"
		)

	if not root then

		PlayersCache = {}

		return
	end

	local list = {}

	for _,p in ipairs(
		Players:GetPlayers()
	) do

		if p ~= LP then

			local c =
				p.Character

			local r =
				c and c:FindFirstChild(
					"HumanoidRootPart"
				)

			local h =
				c and c:FindFirstChildOfClass(
					"Humanoid"
				)

			if r and h and h.Health > 0 then

				table.insert(
					list,
					{
						Player = p,
						Root = r,
						Type = "Player",
						Name = p.DisplayName,
						Distance =
							(root.Position -
							r.Position).Magnitude
					}
				)
			end
		end
	end

	table.sort(
		list,
		function(a,b)
			return a.Distance < b.Distance
		end
	)

	PlayersCache = {}

	for i = 1,
		math.min(
			MAX_PLAYER,
			#list
		) do

		PlayersCache[i] =
			list[i]
	end
end

--==================================================
-- FARM TARGET
--==================================================

local function GetFarmTarget()

	local char =
		LP.Character

	local root =
		char and char:FindFirstChild(
			"HumanoidRootPart"
		)

	if not root then
		return nil
	end

	local best
	local bestDistance =
		math.huge

	for _,data in ipairs(
		Cache[FARM_TYPE] or {}
	) do

		local r =
			data.Root

		if r and r.Parent then

			local d =
				(root.Position -
				r.Position).Magnitude

			if d < bestDistance then

				bestDistance = d
				best = data
			end
		end
	end

	return best
end

--==================================================
-- FARM
--==================================================

