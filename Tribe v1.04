local function Tab(name)

	ESPPage.Visible =
		name == "ESP"

	AIMPage.Visible =
		name == "AIM"

	FarmPage.Visible =
		name == "FARM"

	MiscPage.Visible =
		name == "MISC"

	ESPTab.BackgroundColor3 =
		name == "ESP"
		and Color3.fromRGB(0,170,255)
		or Color3.fromRGB(50,50,50)

	AIMTab.BackgroundColor3 =
		name == "AIM"
		and Color3.fromRGB(0,170,255)
		or Color3.fromRGB(50,50,50)

	FarmTab.BackgroundColor3 =
		name == "FARM"
		and Color3.fromRGB(0,170,255)
		or Color3.fromRGB(50,50,50)

	MiscTab.BackgroundColor3 =
		name == "MISC"
		and Color3.fromRGB(0,170,255)
		or Color3.fromRGB(50,50,50)
end

