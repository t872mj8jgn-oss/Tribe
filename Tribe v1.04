local FarmTypes = {
	"Wood",
	"Stone",
	"Apple",
	"Food"
}

local FarmIndex = 1

Select.MouseButton1Click:Connect(function()

	FarmIndex += 1

	if FarmIndex >
		#FarmTypes then

		FarmIndex = 1
	end

	FARM_TYPE =
		FarmTypes[FarmIndex]

	Select.Text =
		FARM_TYPE.." ▼"

	FarmLabel.Text =
		"Target: "..FARM_TYPE
end)

task.spawn(function()

	while Gui.Parent do

		local char =
			LP.Character

		local humanoid =
			char and char:FindFirstChildOfClass(
				"Humanoid"
			)

		if humanoid then

			humanoid.WalkSpeed =
				math.clamp(
					FARM_SPEED,
					16,
					20
				)

			if AUTO_FARM then

				local target =
					GetFarmTarget()

				if target
					and target.Root then

					humanoid:MoveTo(
						target.Root.Position
					)
				end
			end

			if PLAYER_FARM then

				local target =
					PlayersCache[1]

				if target
					and target.Root then

					humanoid:MoveTo(
						target.Root.Position
					)
				end
			end
		end

		task.wait(.15)
	end
end)

--==================================================
-- ESP
--==================================================

local ESPLabels = {}

local TOTAL =
	MAX_PLAYER +
	MAX_RESOURCE * 4

for i = 1,TOTAL do

	local label =
		Instance.new("TextLabel")

	label.Size =
		UDim2.fromOffset(
			170,
			35
		)

	label.AnchorPoint =
		Vector2.new(.5,.5)

	label.BackgroundTransparency = 1

	label.TextColor3 =
		Color3.new(1,1,1)

	label.TextStrokeTransparency = 0

	label.Font =
		Enum.Font.GothamBold

	label.TextSize = 13
	label.Visible = false
	label.Parent = Gui

	ESPLabels[i] =
		label
end

local function ESPColor(t)

	if t == "Player" then

		return Color3.fromRGB(
			0,255,0
		)

	elseif t == "Wood" then

		return Color3.fromRGB(
			170,100,40
		)

	elseif t == "Stone" then

		return Color3.fromRGB(
			200,200,200
		)

	elseif t == "Apple" then

		return Color3.fromRGB(
			255,40,40
		)

	elseif t == "Food" then

		return Color3.fromRGB(
			255,180,0
		)
	end

	return Color3.new(1,1,1)
end

local function HideESP()

	for _,label in ipairs(
		ESPLabels
	) do

		label.Visible = false
	end
end

task.spawn(function()

	while Gui.Parent do

		ScanResources()

		task.wait(
			RESOURCE_DELAY
		)
	end
end)

task.spawn(function()

	while Gui.Parent do

		ScanPlayers()

		task.wait(
			PLAYER_DELAY
		)
	end
end)

RunService.RenderStepped:Connect(function()

	if not ESP then

		HideESP()

		return
	end

	local camera =
		workspace.CurrentCamera

	local char =
		LP.Character

	local root =
		char and char:FindFirstChild(
			"HumanoidRootPart"
		)

	if not camera or not root then

		HideESP()

		return
	end

	local targets = {}

	for _,d in ipairs(
		PlayersCache
	) do

		table.insert(
			targets,
			d
		)
	end

	for _,list in pairs(Cache) do

		local sorted = {}

		for _,d in ipairs(list) do

			if d.Root
				and d.Root.Parent then

				d.Distance =
					(root.Position -
					d.Root.Position).Magnitude

				table.insert(
					sorted,
					d
				)
			end
		end

		table.sort(
			sorted,
			function(a,b)
				return a.Distance < b.Distance
			end
		)

		for i = 1,
			math.min(
				MAX_RESOURCE,
				#sorted
			) do

			table.insert(
				targets,
				sorted[i]
			)
		end
	end

	for i = 1,TOTAL do

		local label =
			ESPLabels[i]

		local d =
			targets[i]

		if not d
			or not d.Root
			or not d.Root.Parent then

			label.Visible = false

			continue
		end

		local pos =
			camera:WorldToViewportPoint(
				d.Root.Position
			)

		if pos.Z <= 0 then

			label.Visible = false

			continue
		end

		label.Position =
			UDim2.fromOffset(
				math.clamp(
					pos.X,
					50,
					camera.ViewportSize.X-50
				),
				math.clamp(
					pos.Y-25,
					20,
					camera.ViewportSize.Y-20
				)
			)

		label.TextColor3 =
			ESPColor(d.Type)

		label.Text =
			d.Name..
			"\n"..
			math.floor(
				d.Distance
			)..
			" studs"

		label.Visible = true
	end
end)

ESPButton.MouseButton1Click:Connect(function()

	ESP =
		not ESP

	ESPButton.Text =
		ESP
		and "ESP : ON"
		or "ESP : OFF"

	ESPButton.BackgroundColor3 =
